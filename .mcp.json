{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--browser", "chromium"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.4.4"]
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.36.0"],
      "env": { "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-}" }
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server@3.4.2"],
      "env": { "EXA_API_KEY": "${EXA_API_KEY:-}" }
    }
  }
}
