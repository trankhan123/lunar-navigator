# Server-only. Copy to .env.local for local development; never commit real values.
# Leave disabled until Gemini and Redis are configured and tested.
AI_CHAT_ENABLED=false
GEMINI_API_KEY=
# Confirmed by the project owner: 20 RPM, 300K TPM, 600 RPD (quota can change).
GEMINI_MODEL=gemini-3.5-flash-lite
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHAT_SESSION_SECRET=
# Shared across all deployments using the same Redis database; UTC calendar windows.
CHAT_GLOBAL_DAILY_LIMIT=50
CHAT_GLOBAL_MINUTE_LIMIT=3
